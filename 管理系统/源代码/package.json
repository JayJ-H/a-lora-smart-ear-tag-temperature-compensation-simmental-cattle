{
  "name": "cattle-management-platform",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.8.0"
  },
  "scripts": {
    "dev": "vite --open",
    "dev:web": "vite --host 127.0.0.1 --port 9191",
    "dev:local": "powershell -ExecutionPolicy Bypass -File 脚本/start-local-platform.ps1",
    "dev:local:windows": "powershell -ExecutionPolicy Bypass -File 脚本/start-local-platform.ps1",
    "dev:local:linux": "bash 脚本/start-local-platform.sh",
    "dev:api": "node 脚本/mysql-backend-server.mjs",
    "db:local": "docker compose -f 数据库/mysql/docker-compose.local.yml up -d",
    "check:local": "node 脚本/check-local-system.mjs",
    "check:prod": "node 脚本/check-production-system.mjs",
    "test:acceptance": "node 脚本/validate-production-acceptance.mjs",
    "test:security": "node 脚本/validate-security-permissions.mjs",
    "test:traceability": "node 脚本/validate-page-db-traceability.mjs",
    "test:deployment": "node 脚本/validate-deployment-consistency.mjs",
    "test:period-fields": "node 脚本/validate-import-export-period-fields.mjs",
    "test:period-fields:runtime": "node 脚本/validate-period-field-runtime.mjs",
    "test:livestock-identity": "node 脚本/validate-livestock-product-identity.mjs",
    "test:livestock-ui": "node 脚本/validate-livestock-ui-contracts.mjs",
    "test:livestock-ui:routes": "node 脚本/smoke-livestock-ui-routes.mjs",
    "test:mqtt": "node 脚本/test-mqtt-ingest.mjs",
    "check:th-shrc:live": "node 脚本/check-th-shrc-live.mjs",
    "test:health-alert-rules": "node 脚本/validate-health-alert-rules.mjs && tsx 脚本/validate-health-alert-rules-frontend.ts",
    "test:omics": "node 脚本/validate-omics-analysis.mjs",
    "prod:up": "docker compose --env-file 运维/生产配置/.env.prod -f 运维/生产配置/docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose --env-file 运维/生产配置/.env.prod -f 运维/生产配置/docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file 运维/生产配置/.env.prod -f 运维/生产配置/docker-compose.prod.yml logs -f",
    "backup:mysql": "powershell -ExecutionPolicy Bypass -File 脚本/backup-mysql.ps1",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint  \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "commit": "git-cz",
    "test:th-shrc-runtime": "node 脚本/validate-th-shrc-exact-reference.mjs && node 脚本/validate-th-shrc-runtime.mjs"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vue/reactivity": "^3.5.21",
    "@vueuse/core": "^13.9.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "next",
    "aedes": "^0.51.3",
    "axios": "^1.12.2",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dexie": "^4.2.1",
    "dotenv": "^17.3.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.2",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.10.0",
    "mitt": "^3.0.1",
    "mqtt": "^5.14.1",
    "mysql2": "^3.19.0",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "qrcode.vue": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.21",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.5.1",
    "xgplayer": "^3.0.20",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.0.5",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.0.5",
    "commitizen": "^4.3.0",
    "cz-git": "^1.11.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "globals": "^15.9.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.5.2",
    "playwright-core": "^1.60.0",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.81.0",
    "stylelint": "^16.20.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "terser": "^5.36.0",
    "tsx": "^4.20.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vue-demi": "^0.14.9",
    "vue-img-cutter": "^3.0.5",
    "vue-tsc": "~2.1.6"
  },
  "packageManager": "pnpm@8.15.9"
}
