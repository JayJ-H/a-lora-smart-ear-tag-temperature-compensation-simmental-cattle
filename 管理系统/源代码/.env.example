VITE_VERSION=1.0.1
VITE_BASE_URL=/
VITE_API_URL=/
VITE_ACCESS_MODE=backend
VITE_WITH_CREDENTIALS=false
VITE_OPEN_ROUTE_INFO=false
VITE_DROP_CONSOLE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
MYSQL_DATABASE=cattle_management
MYSQL_USER=cattle_user
MYSQL_PASSWORD=replace_with_a_local_database_password
MYSQL_API_PORT=9192
MYSQL_POOL_LIMIT=10

AUTH_MODE=strict
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_a_local_admin_password
AUTH_SESSION_TTL_MS=43200000
DEFAULT_PERSON_PASSWORD=replace_with_a_temporary_person_password

MQTT_ENABLED=false
MQTT_HOST=0.0.0.0
MQTT_PORT=1883
MQTT_TOPIC=cattle/+/temperature
MQTT_USERNAME=replace_with_a_mqtt_username
MQTT_PASSWORD=replace_with_a_mqtt_password

TH_SHRC_ENABLED=true
