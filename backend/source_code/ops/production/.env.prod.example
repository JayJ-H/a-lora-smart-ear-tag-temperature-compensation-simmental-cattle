# Copy to .env.prod and replace every replace_with_* value before starting production.
# The API fails fast in NODE_ENV=production if strict auth or required secrets are missing/placeholders.
MYSQL_ROOT_PASSWORD=replace_with_a_long_root_password
MYSQL_DATABASE=cattle_management
MYSQL_USER=cattle_user
MYSQL_PASSWORD=replace_with_a_long_database_password
MYSQL_HOST_PORT=9193
MYSQL_POOL_LIMIT=10
BUILD_VERSION=1.0.1
BUILD_REF=v1.0.1
BUILD_SOURCE=production
NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
MYSQL_CONTAINER_NAME=benniu-mysql
API_CONTAINER_NAME=benniu-api
WEB_CONTAINER_NAME=benniu-web
CADDY_CONTAINER_NAME=benniu-caddy

AUTH_MODE=strict
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_a_long_admin_password
AUTH_SESSION_TTL_MS=43200000

WEB_HOST_PORT=19191
API_HOST_PORT=9192

MQTT_ENABLED=true
MQTT_HOST=0.0.0.0
MQTT_PORT=1883
MQTT_HOST_PORT=9195
MQTT_TOPIC=cattle/+/temperature
MQTT_USERNAME=cattle_gateway
MQTT_PASSWORD=replace_with_a_long_mqtt_password
TH_SHRC_ENABLED=true
OMICS_SERVICE_URL=http://127.0.0.1:8090
CADDY_IMAGE=caddy:2.8-alpine

PUBLIC_HOST=localhost
