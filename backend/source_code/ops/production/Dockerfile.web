ARG NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
ARG NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
ARG BUILD_VERSION=1.0.1
ARG BUILD_REF=unknown
ARG BUILD_SOURCE=production-web
FROM ${NODE_IMAGE} AS builder
ARG BUILD_VERSION
ARG BUILD_REF=unknown
ARG BUILD_SOURCE=production-web

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@8.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
ENV NODE_OPTIONS=--max-old-space-size=4096
ENV APP_BUILD_VERSION=${BUILD_VERSION}
ENV APP_BUILD_REF=${BUILD_REF}
ENV APP_BUILD_SOURCE=${BUILD_SOURCE}
ENV VITE_VERSION=${BUILD_VERSION}
ENV VITE_BASE_URL=/
ENV VITE_API_URL=/
ENV VITE_ACCESS_MODE=backend
ENV VITE_WITH_CREDENTIALS=false
ENV VITE_OPEN_ROUTE_INFO=false
ENV VITE_DROP_CONSOLE=true
RUN pnpm run build
RUN node --input-type=module -e 'import { createHash } from "node:crypto"; import { readdir, readFile, stat, writeFile } from "node:fs/promises"; import path from "node:path"; const root = "/app/dist"; const pkg = JSON.parse(await readFile("/app/package.json", "utf8")); async function readText(file, fallback = "") { try { return await readFile(file, "utf8"); } catch { return fallback; } } function envValue(text, key) { const row = text.split(/\r?\n/).find((line) => line.trim().startsWith(`${key}`)); if (!row || !row.includes("=")) return ""; return row.slice(row.indexOf("=") + 1).trim().replace(/^["]|["]$/g, ""); } function excluded(rel) { return rel === "version.json" || rel.endsWith(".gz"); } async function listFiles(dir) { const entries = await readdir(dir, { withFileTypes: true }); const files = []; for (const entry of entries) { const fullPath = path.join(dir, entry.name); if (entry.isDirectory()) files.push(...await listFiles(fullPath)); else if (entry.isFile()) files.push(fullPath); } return files; } const envText = await readText("/app/.env.production"); const files = (await listFiles(root)).map((file) => ({ file, rel: path.relative(root, file).split(path.sep).join("/") })).filter((item) => !excluded(item.rel)).sort((a, b) => a.rel.localeCompare(b.rel)); const manifest = []; const treeHash = createHash("sha256"); for (const item of files) { const bytes = await readFile(item.file); const fileHash = createHash("sha256").update(bytes).digest("hex"); const fileStat = await stat(item.file); manifest.push({ path: item.rel, bytes: fileStat.size, sha256: fileHash }); treeHash.update(`${item.rel}\0${fileHash}\0${fileStat.size}\n`); } const distHash = treeHash.digest("hex"); const createdAt = new Date().toISOString(); const buildVersion = process.env.APP_BUILD_VERSION || envValue(envText, "VITE_VERSION") || pkg.version || "0.0.0"; const metadata = { name: pkg.name || "nzh-control-platform", version: buildVersion, build: { target: "web", source: process.env.APP_BUILD_SOURCE || "production-web", ref: process.env.APP_BUILD_REF || "unknown", createdAt }, hash: distHash, buildHash: distHash, builtAt: createdAt, hashAlgorithm: "sha256-dist-tree-v1", hashExcludes: ["version.json", "*.gz"], files: manifest.length, bytes: manifest.reduce((sum, item) => sum + item.bytes, 0) }; await writeFile(path.join(root, "version.json"), `${JSON.stringify(metadata, null, 2)}\n`);'

FROM ${NGINX_IMAGE}

COPY ops/production/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
